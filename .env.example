# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/servicios_db?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET="reemplazar-por-secreto-fuerte"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="reemplazar-por-otro-secreto-fuerte"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="servicios-verificaciones"
R2_ENDPOINT=""

# --- Verificación telefónica (WhatsApp Business API + fallback SMS) ---
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
SMS_FALLBACK_PROVIDER=""
SMS_FALLBACK_API_KEY=""

# --- App ---
NODE_ENV="development"
API_PORT=3001
FRONTEND_URL="http://localhost:3000"

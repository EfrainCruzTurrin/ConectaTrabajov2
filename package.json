{
  "name": "servicios-platform",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prisma": "^5.19.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @servicios/api start:dev",
    "dev:web": "pnpm --filter @servicios/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./prisma/schema.prisma"
  }
}

{
  "name": "servicios-platform",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @servicios/api start:dev",
    "dev:web": "pnpm --filter @servicios/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prisma:generate": "pnpm --filter @servicios/api exec prisma generate --schema=../../prisma/schema.prisma",
    "prisma:migrate": "pnpm --filter @servicios/api exec prisma migrate dev --schema=../../prisma/schema.prisma",
    "prisma:studio": "pnpm --filter @servicios/api exec prisma studio --schema=../../prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
